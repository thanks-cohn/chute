{
  "openapi": "3.1.0",
  "info": {
    "title": "Chutey scoped local Explorer API",
    "version": "1.0-p0-2026-11-17",
    "description": "Implemented scoped Development 1 and P0 repair candidate; see P0-NATIVE-API-2026-11-17.md. Independent automation enrollment, resumable bulk jobs and Movie Mode adapter registry remain gated future work."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:17891"
    }
  ],
  "paths": {
    "/api/explorer/v1/command": {
      "post": {
        "summary": "Versioned permission-checked Explorer command",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "command"
                ],
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string",
                    "enum": [
                      "capabilities",
                      "roots",
                      "list",
                      "search",
                      "stat",
                      "preview",
                      "resume_location",
                      "remember_location",
                      "revoke_access",
                      "prepare_export",
                      "export_to_live",
                      "receive_from_live",
                      "recent_transfers",
                      "reconcile_transfer",
                      "media_source",
                      "release_media",
                      "locate_saved",
                      "open",
                      "reveal",
                      "history_export_create",
                      "history_export_status",
                      "history_export_cancel",
                      "saved_text_page",
                      "transfer_start",
                      "transfer_status",
                      "transfer_cancel",
                      "transfer_dismiss",
                      "upload_receipt",
                      "renew_media",
                      "media_status",
                      "media_diagnostics",
                      "media_policy_get",
                      "media_policy_set",
                      "performance_get",
                      "performance_set",
                      "transfer_verify",
                      "clipboard_copy_files",
                      "clipboard_copy_image",
                      "clipboard_read_files",
                      "clipboard_release"
                    ]
                  },
                  "args": {
                    "type": "object",
                    "description": "Command-specific parameters in the linked API documents. transfer_start and history_export_create return an inner asynchronous state; accepted/running are not completion."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Outer dispatch receipt. For export/transfer jobs inspect inner result.state and poll status until verified ready/COMMITTED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "403": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "429": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        },
        "description": "Exact Origin and authenticated session required; JSON <=16 KiB. See P0-NATIVE-API-2026-11-17.md for command argument contracts. Dispatch state completed does not imply inner transfer job COMMITTED. Capacity returns 429 BUSY with independent lanes."
      }
    },
    "/api/explorer/v1/content": {
      "post": {
        "summary": "Authorized preview, original (newer worker only), or bounded image thumbnail",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Single bytes=start-end, bytes=start-, or bytes=-suffix range."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "handle",
                  "identity"
                ],
                "properties": {
                  "handle": {
                    "type": "string"
                  },
                  "identity": {
                    "type": "string"
                  },
                  "thumbnail": {
                    "type": "boolean",
                    "default": false
                  },
                  "original": {
                    "type": "boolean",
                    "description": "Omit entirely on November 4 worker; false is also rejected there."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guarded content bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial bytes; Content-Range, Content-Length, Accept-Ranges returned"
          },
          "400": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "403": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "416": {
            "description": "Unsatisfiable/invalid range; Content-Range: bytes */size"
          },
          "429": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        }
      }
    },
    "/api/explorer/v1/receive": {
      "post": {
        "summary": "Existing synchronous guarded upload; no batch job API",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "name": "X-Chute-Destination",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Approved writable folder handle"
          },
          {
            "name": "X-Chute-Filename",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Percent-encoded filename"
          },
          {
            "name": "X-Chute-Operation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique operation ID for native reconciliation"
          },
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Known byte count"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transfer receipt: require state COMMITTED; uncertain results require reconciliation"
          },
          "400": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "403": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "429": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        }
      }
    },
    "/api/explorer/v1/media/{ticket}": {
      "get": {
        "summary": "Authorized file-specific media bytes with single HTTP range support",
        "security": [],
        "description": "The opaque single-file read ticket is minted with authenticated media_source. Exact enrolled Origin and loopback Host remain mandatory. Lease lasts 120 seconds; authenticated renew_media extends it without replacing the URL. General session expiry does not revoke a continuing lease; explicit grant revocation, release, identity change and lease expiry stop reads. No general bearer token in URL. Archived workers do not implement continuation. Chrome extension media transport restores the exact extension Origin using an initiator- and endpoint-scoped DNR session rule; websites and general API requests do not match. See P0-NATIVE-API-2026-11-17.md.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full bytes or HEAD metadata; Content-Length, Content-Type, Accept-Ranges"
          },
          "206": {
            "description": "Range bytes, Content-Range and length"
          },
          "400": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "403": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "416": {
            "description": "Invalid range, Content-Range: bytes */size"
          },
          "429": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "503": {
            "description": "Global bounded HTTP thread admission exhausted; retry after brief backoff, do not reconnect or select a new folder."
          }
        }
      },
      "head": {
        "summary": "Authorized file-specific media metadata without response body; Range ignored",
        "security": [],
        "description": "The opaque single-file read ticket is minted with authenticated media_source. Exact enrolled Origin and loopback Host remain mandatory. Lease lasts 120 seconds; authenticated renew_media extends it without replacing the URL. General session expiry does not revoke a continuing lease; explicit grant revocation, release, identity change and lease expiry stop reads. No general bearer token in URL. Archived workers do not implement continuation. Chrome extension media transport restores the exact extension Origin using an initiator- and endpoint-scoped DNR session rule; websites and general API requests do not match. See P0-NATIVE-API-2026-11-17.md.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full bytes or HEAD metadata; Content-Length, Content-Type, Accept-Ranges"
          },
          "206": {
            "description": "Range bytes, Content-Range and length"
          },
          "400": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "403": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "416": {
            "description": "Invalid range, Content-Range: bytes */size"
          },
          "429": {
            "description": "Failed operation; inspect state and error.code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "503": {
            "description": "Global bounded HTTP thread admission exhausted; retry after brief backoff, do not reconnect or select a new folder."
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Lightweight current live-basket count",
        "security": [],
        "description": "Existing basket CORS policy; no filesystem grant or native session enrollment. Count is derived from Store.",
        "responses": {
          "200": {
            "description": "Live basket count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "service",
                    "count"
                  ],
                  "properties": {
                    "service": {
                      "const": "chute"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/explorer/v1/highlights": {
      "post": {
        "summary": "Idempotent daily UTF-8 highlight capture",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "name": "X-Chute-Capture-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          },
          {
            "name": "X-Chute-Source",
            "in": "header",
            "schema": {
              "type": "string",
              "description": "Percent-encoded authorized source metadata"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain;charset=utf-8": {
              "schema": {
                "type": "string",
                "format": "binary",
                "maxLength": 4194304
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Durably committed capture; verify capture_id, input_size and input_sha256. Includes document_id, received_at, entry_offset and immutable file metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HighlightReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, too large, duplicate ID with different content, or recovery review required"
          },
          "403": {
            "description": "Missing/expired enrolled session or wrong Origin"
          }
        }
      }
    },
    "/api/explorer/v1/history-download/{capability}": {
      "get": {
        "summary": "One verified ZIP64 metadata archive; no multipart volumes",
        "security": [],
        "description": "Secret 256-bit one-hour download capability issued by authenticated history_export_create/status. Exact loopback Host; missing Origin allowed for native download, foreign Origin denied. 256-KiB bounded stream; no full JS archive Blob.",
        "parameters": [
          {
            "name": "capability",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single attachment: history.csv + history.json + manifest.json; Content-Length. Download completion is distinct from archive-ready.",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Expired, cancelled or unauthorized download"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Native approved session, not independently enrolled script credentials."
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^chrome-extension://[a-p]{32}$"
        },
        "description": "Exact enrolled extension origin; header alone supplies no authority."
      }
    },
    "schemas": {
      "Receipt": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "completed",
              "failed"
            ]
          },
          "result": {
            "type": "object",
            "description": "Command-specific result. transfer_* use TransferJob, history_export_* use HistoryExportJob, saved_text_page uses SavedTextPage. Read inner states before claiming completion."
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "TransferJob": {
        "type": "object",
        "required": [
          "id",
          "state",
          "kind",
          "bytes",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "state": {
            "enum": [
              "accepted",
              "running",
              "COMMITTED",
              "failed",
              "cancelled",
              "UNCERTAIN"
            ]
          },
          "kind": {
            "enum": [
              "local_to_live",
              "local_copy",
              "live_to_local"
            ]
          },
          "phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "receipt": {
            "type": [
              "object",
              "null"
            ],
            "description": "Verified SHA-256 and size/name/handle or immutable Store file metadata only when COMMITTED."
          }
        }
      },
      "HistoryExportJob": {
        "type": "object",
        "required": [
          "id",
          "state",
          "count",
          "scope",
          "timezone",
          "cutoff"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "accepted",
              "running",
              "ready",
              "failed",
              "cancelled"
            ]
          },
          "phase": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "enum": [
              "all",
              "today",
              "range"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "cutoff": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string"
          },
          "size": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "description": "Relative one-hour download capability, only ready."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SavedTextPage": {
        "type": "object",
        "required": [
          "text",
          "offset",
          "next",
          "size",
          "entry_offset",
          "capture_id"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "next": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "entry_offset": {
            "type": "integer",
            "minimum": 0
          },
          "capture_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      },
      "HighlightReceipt": {
        "type": "object",
        "required": [
          "state",
          "capture_id",
          "received_at",
          "input_size",
          "input_sha256",
          "document_id",
          "entry_offset",
          "file"
        ],
        "properties": {
          "state": {
            "const": "COMMITTED"
          },
          "capture_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "received_at": {
            "type": "string"
          },
          "input_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entry_offset": {
            "type": "integer",
            "minimum": 0
          },
          "file": {
            "type": "object",
            "description": "Immutable QueueItem public metadata; capture ID distinct from daily document ID."
          }
        }
      },
      "PerformanceState": {
        "type": "object",
        "required": [
          "mode",
          "effective_limits",
          "hardware",
          "resources",
          "metrics"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "efficiency",
              "balanced",
              "turbo"
            ]
          },
          "effective_limits": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "hardware": {
            "type": "object"
          },
          "resources": {
            "type": "object",
            "description": "Current worker numeric memory/CPU/thread counters; no environment, paths or tokens"
          },
          "metrics": {
            "type": "object",
            "description": "Bounded per-lane active/completed/BUSY counters and last-512 request latency percentiles"
          }
        }
      },
      "MediaPolicy": {
        "type": "object",
        "required": [
          "allowed",
          "scope"
        ],
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "enum": [
              "approved_folder",
              "saved_store"
            ]
          },
          "migrated": {
            "type": "boolean"
          }
        }
      },
      "ClipboardSnapshot": {
        "type": "object",
        "description": "Version 1 native clipboard response; files carry metadata and indexes, never local paths. 5-minute scope is paste-only, not browsable. See WINDOWS-CLIPBOARD-API.md.",
        "properties": {
          "version": {
            "const": 1
          },
          "snapshot": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object"
            }
          },
          "expires_in": {
            "type": "integer"
          }
        }
      }
    }
  }
}
