{
  "manifest_version": 3,
  "name": "Chutey",
  "short_name": "Chutey",
  "version": "2.6.1",
  "description": "Drag files, images, links, and text through one local Chute basket with recallable history.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/thanks-cohn/chute",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-entry.js"
  },
  "action": {
    "default_title": "Chutey",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "shelf.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "content-auto-hide.js",
        "content-image-resolver.js",
        "direct-drop-google-yandex.js",
        "drop-lifecycle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bin.html",
        "bin.css",
        "bin.js",
        "bin-sidepanel.js",
        "bin-capture-settings.js",
        "bin-provenance.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
