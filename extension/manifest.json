{
  "manifest_version": 3,
  "name": "Chute",
  "short_name": "Chute",
  "version": "2.5.0",
  "description": "Drag files, images, links, and text through one local Chute basket with recallable history.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/thanks-cohn/chute",
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-entry.js"
  },
  "action": {
    "default_title": "Chute",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "shelf.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js", "content-auto-hide.js", "content-image-resolver.js", "direct-drop-google-yandex.js", "drop-lifecycle.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bin.html",
        "bin.css",
        "bin.js",
        "bin-capture-settings.js",
        "bin-provenance.js",
        "bin-drag-support.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
