{
  "manifest_version": 3,
  "name": "Chute",
  "version": "2.0.2",
  "description": "A persistent browser chute with local recallable history and generated image thumbnails.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "http://127.0.0.1:17891/*",
    "http://localhost:17891/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-entry.js"
  },
  "action": {
    "default_title": "Chute",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "shelf.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js", "content-auto-hide.js", "content-image-resolver.js", "direct-drop-google-yandex.js", "drop-lifecycle.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bin.html",
        "bin.css",
        "bin.js",
        "bin-capture-settings.js",
        "bin-provenance.js",
        "bin-drag-support.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
