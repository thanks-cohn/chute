{
  "manifest_version": 3,
  "name": "Chute",
  "short_name": "Chute",
  "version": "2.6.0",
  "description": "Drop images from Google, Yandex, and ChatGPT into a private browser shelf and optionally one folder you choose.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/thanks-cohn/chute",
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "store-background.js"
  },
  "action": {
    "default_title": "Open Chute Shelf"
  },
  "side_panel": {
    "default_path": "shelf.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["source-resource.js", "image-source-capture.js", "store-mascot.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.google.com/*"],
      "js": ["source-resource.js", "image-source-capture.js", "store-mascot.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.yandex.com/*",
        "https://*.yandex.ru/*",
        "https://*.yandex.kz/*",
        "https://*.yandex.by/*",
        "https://*.yandex.uz/*",
        "https://*.yandex.com.tr/*"
      ],
      "js": ["source-resource.js", "image-source-capture.js", "store-mascot.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
