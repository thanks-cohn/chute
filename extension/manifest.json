{
  "manifest_version": 3,
  "name": "Chute",
  "version": "0.3.0",
  "description": "A persistent browser bin for files sent from the terminal or dropped from the web.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "http://127.0.0.1:17891/*",
    "http://localhost:17891/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chute",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "shelf.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bin.html", "bin.css", "bin.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
